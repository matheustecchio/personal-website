---
import Layout from '../layouts/Layout.astro';
import ProjectCover from '../components/ProjectCover.astro';
import ProjectLinks from '../components/ProjectLinks.astro';
import Arrow from '../components/Arrow.astro';
import { projects } from '../data/projects';
---
<Layout title="Projects · Matheus Tecchio" description="Explore Gentum Finance, Safe Code and Ticket Report Generator, with source code, documentation and details about each build.">
  <header class="page-intro"><h1>A few things<br /><span>I've built.</span></h1><p>Practical tools, personal projects, and the details behind them. The source and documentation are right here if you'd like a closer look.</p></header>
  <section class="project-list" aria-label="Projects">
    {projects.map(project => <article class="project-detail" id={project.slug}>
      <div class="project-visual"><ProjectCover kind={project.slug} /><p class="cover-caption">{project.category}<span>{project.year}</span></p></div>
      <div class="project-copy"><span class="project-status">{project.status}</span><h2>{project.name}</h2><h3>{project.summary}</h3><p>{project.description}</p><p>{project.detail}</p><ul class="tags" aria-label="Technologies">{project.tags.map(tag => <li>{tag}</li>)}</ul><ProjectLinks {...project} /></div>
    </article>)}
  </section>
  <section class="demo-section" aria-labelledby="demo-title"><div><h2 id="demo-title">Safe Code,<br /><span>in the editor.</span></h2><p>The extension highlights possible secrets in your code and lists findings in the Problems tab.</p></div><picture><source srcset="/images/safe-code-still.png" media="(prefers-reduced-motion: reduce)" /><img src="/images/safe-code-demo.gif" width="616" height="408" loading="lazy" alt="Safe Code demonstration showing possible hardcoded secrets highlighted in VS Code and listed in the Problems tab" /></picture></section>
  <div class="projects-close"><p>There's more in the repositories.</p><a class="text-link" href="https://github.com/matheustecchio?tab=repositories" target="_blank" rel="noopener noreferrer">Browse GitHub <Arrow external /></a></div>
</Layout>
