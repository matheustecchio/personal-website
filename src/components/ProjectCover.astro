---
interface Props { kind: string; small?: boolean }
const { kind, small = false } = Astro.props;
const projectImage = kind === 'gentum-finance'
  ? { src: '/images/gentum-finance-project.png', width: 1598, height: 1013 }
  : kind === 'safe-code'
    ? { src: '/images/safe-code-project.png', width: 1200, height: 800 }
    : undefined;
---
<div class:list={['project-cover', kind, { small, 'has-image': projectImage }]} aria-hidden="true">
  {projectImage ? <img src={projectImage.src} alt="" width={projectImage.width} height={projectImage.height} loading={small ? 'eager' : 'lazy'} /> : kind === 'gentum-finance' ? <>
    <span class="cover-label">LOCAL PERSONAL FINANCE</span>
    <div class="gentum-word">gentum<span>_</span></div>
    <div class="cover-bottom"><span>Accounts. Budgets. Clarity.</span><span class="cover-mark">g.</span></div>
  </> : kind === 'safe-code' ? <>
    <span class="cover-label">A LITTLE LESS EXPOSURE.</span>
    <div class="safe-word"><span class="bracket">[</span> safe<span class="safe-break">code<span class="bracket"> ]</span></span></div>
    <div class="cover-bottom"><span>Keep secrets out of source.</span><span class="cover-mark">*</span></div>
  </> : <>
    <span class="cover-label">ONE LESS REPETITIVE TASK.</span>
    <div class="report-word">.xlsx<br /><span>to .pdf</span></div>
    <div class="cover-bottom"><span>Ticket Report Generator</span><span class="cover-mark">/</span></div>
  </>}
</div>
